#!/usr/bin/env bash
# Insert the current window at an existing index, shifting the intervening windows.
set -euo pipefail
[[ ${1:-} =~ ^[0-9]+$ ]] || { printf 'Usage: tmux-insert-window INDEX\n' >&2; exit 1; }
target=$((10#$1))
source=$(tmux display-message -p '#{session_id}:#{window_id}')
session=${source%%:*}
current=$(tmux display-message -p -t "$source" '#{window_index}')
[[ "$current" != "$target" ]] || exit 0
target_id=$(tmux list-windows -t "$session" -F '#{window_index} #{window_id}' \
  | awk -v target="$target" '$1 == target {print $2}')
[[ -n "$target_id" ]] || { printf 'No window at index %s\n' "$target" >&2; exit 1; }
if ((current > target)); then
  tmux move-window -b -s "$source" -t "$session:$target"
else
  tmux move-window -a -s "$source" -t "$session:$target"
fi
tmux move-window -r -t "$session:"
