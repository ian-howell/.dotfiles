#!/usr/bin/env bash
#
# rp - Switch to a tmux session for a git repo under a set of source roots
#
# Usage: rp [query]
#
# Discovers all git repos under the configured source roots, opens an fzf
# picker, and switches to (or creates) a tmux session rooted at the selected
# repo. Session name is the repo's directory basename.
# An optional query argument pre-fills the fzf search.
#
# Source roots come from rp.d/defaults.conf (one path per line). Additional
# machine-specific roots can be supplied via the RP_SRC_ROOTS environment
# variable, colon-separated like $PATH (so directory names may not contain
# colons), e.g. RP_SRC_ROOTS="$HOME/work/repos:$HOME/clients/acme".
#
set -euo pipefail

# rp lives in bin/rp.d/ and is symlinked from bin/, so resolve the real path
# to locate defaults.conf regardless of how it was invoked.
script_dir=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
defaults_file="$script_dir/defaults.conf"

# Gather candidate roots from defaults.conf (comments/blank lines stripped).
candidate_roots=()
if [[ -r "$defaults_file" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"                        # strip trailing comment
    line="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
    line="${line%"${line##*[![:space:]]}"}"   # trim trailing whitespace
    if [[ -n "$line" ]]; then
      candidate_roots+=("$line")
    fi
  done <"$defaults_file"
fi

# Layer in machine-specific roots from the environment (colon-separated).
if [[ -n "${RP_SRC_ROOTS:-}" ]]; then
  IFS=: read -ra env_roots <<<"$RP_SRC_ROOTS"
  candidate_roots+=("${env_roots[@]}")
fi

# Expand each candidate, drop roots that don't exist, and dedupe by resolved
# path so aliased/symlinked roots aren't searched twice.
src_roots=()
declare -A seen_roots=()
for candidate in "${candidate_roots[@]}"; do
  expanded="${candidate/#\~/$HOME}"
  expanded="${expanded//\$HOME/$HOME}"
  [[ -d "$expanded" ]] || continue
  resolved=$(readlink -f -- "$expanded")
  if [[ -z "${seen_roots[$resolved]:-}" ]]; then
    seen_roots["$resolved"]=1
    src_roots+=("$resolved")
  fi
done

if ((${#src_roots[@]} == 0)); then
  # shellcheck disable=SC2016  # literal $RP_SRC_ROOTS in the message is intentional
  printf 'rp: no existing source roots (checked %s and $RP_SRC_ROOTS)\n' \
    "$defaults_file" >&2
  exit 1
fi

# List repos as "basename\t/full/path"
# Excludes .worktrees directories to avoid listing worktree pseudo-repos.
list_repos() {
  for src_root in "${src_roots[@]}"; do
    [[ -d "$src_root" ]] || continue
    find "$src_root" -mindepth 2 -maxdepth 5 -name '.git' -type d \
      -not -path '*/.worktrees/*' \
      2>/dev/null \
      | sed 's|/.git$||' \
      | while read -r repo_path; do
          name=$(basename "$repo_path")
          printf '%s\t%s\n' "$name" "$repo_path"
        done
  done | sort -t$'\t' -k1,1
}

# Annotate repos: append "(active)" column if a session with that name exists.
annotate() {
  local active_sessions
  active_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
  while IFS=$'\t' read -r name path; do
    if echo "$active_sessions" | grep -qxF "$name"; then
      printf '%s\t%s\t(active)\n' "$name" "$path"
    else
      printf '%s\t%s\t\n' "$name" "$path"
    fi
  done
}

query="${1:-}"

selected=$(
  list_repos | annotate \
    | fzf \
        --ansi \
        --height=100% \
        --layout=reverse \
        --preview-window='bottom,60%' \
        --query="$query" \
        --prompt="repo> " \
        --delimiter=$'\t' \
        --with-nth='1,3' \
        --preview='git -C {2} log --oneline --color=always -20 2>/dev/null; echo; git -C {2} branch --color=always 2>/dev/null' \
  || true
)

[[ -z "$selected" ]] && exit 0

name=$(printf '%s' "$selected" | cut -f1)
repo_path=$(printf '%s' "$selected" | cut -f2)

tmux-switch "$name" --dir "$repo_path"
