@@ -0,0 +1,68 @@
+"""WSL records the Windows mic through ffmpeg.exe instead of WSLg PulseAudio."""
+
+import io
+import struct
+
+import pytest
+
+from tools import voice_mode
+
+
+class _FakeProc:
+    def __init__(self, pcm: bytes):
+        self.stdout = io.BytesIO(pcm)
+        self.stderr = io.BytesIO(b"")
+
+    def poll(self):
+        return None
+
+    def kill(self):
+        pass
+
+    def wait(self, timeout=None):
+        return 0
+
+
+@pytest.fixture
+def wsl(monkeypatch):
+    monkeypatch.setattr(voice_mode, "is_wsl", lambda: True)
+    monkeypatch.setattr(voice_mode, "_termux_voice_capture_available", lambda: False)
+    monkeypatch.setattr(voice_mode, "_windows_ffmpeg", lambda: "/mnt/c/ffmpeg.exe")
+
+
+def test_wsl_picks_windows_mic_recorder(wsl, monkeypatch):
+    monkeypatch.setattr(voice_mode, "_voice_config", lambda: {})
+    assert isinstance(voice_mode.create_audio_recorder(), voice_mode.WindowsMicRecorder)
+
+
+def test_wsl_mic_pulse_keeps_sounddevice_recorder(wsl, monkeypatch):
+    monkeypatch.setattr(voice_mode, "_voice_config", lambda: {"wsl_mic": "pulse"})
+    recorder = voice_mode.create_audio_recorder()
+    assert type(recorder) is voice_mode.AudioRecorder
+
+
+def test_windows_mic_recorder_writes_captured_audio(wsl, monkeypatch):
+    monkeypatch.setattr(voice_mode, "_voice_config", lambda: {})
+    pcm = struct.pack("<16000h", *([3000, -3000] * 8000))
+    started = []
+
+    def fake_popen(cmd, **kwargs):
+        started.append(cmd)
+        return _FakeProc(pcm)
+
+    monkeypatch.setattr(voice_mode.subprocess, "Popen", fake_popen)
+    recorder = voice_mode.create_audio_recorder()
+    recorder._recording = True  # capture from the first block
+    recorder._start_time = voice_mode.time.monotonic()
+    recorder._ensure_stream()
+    import time
+    deadline = time.monotonic() + 2
+    while sum(len(f) for f in recorder._frames) < 16000 and time.monotonic() < deadline:
+        time.sleep(0.01)
+    path = recorder._stop_capture()
+
+    assert started[0][started[0].index("-f") + 1] == "openal"
+    import wave
+    with wave.open(path) as wf:
+        assert wf.getframerate() == 16000
+        assert wf.getnframes() == 16000
