+++ w/tests/tools/test_voice_wsl_windows_player.py
@@ -0,0 +1,65 @@
+"""WSL playback goes through a resident Windows PowerShell player, bypassing WSLg audio."""
+import subprocess
+
+import pytest
+
+from tools import voice_mode
+
+
+class _FakePlayer:
+    def __init__(self, reply: str):
+        self.reply = reply
+        self.written = []
+        self.stdin = self
+        self.stdout = self
+
+    def poll(self):
+        return None
+
+    def write(self, s):
+        self.written.append(s)
+
+    def flush(self):
+        pass
+
+    def readline(self):
+        return self.reply + "\n"
+
+
+@pytest.fixture
+def wav(tmp_path):
+    p = tmp_path / "a.wav"
+    p.write_bytes(b"RIFF")
+    return str(p)
+
+
+def _wsl(monkeypatch, reply):
+    player = _FakePlayer(reply)
+    monkeypatch.setattr(voice_mode, "is_wsl", lambda: True)
+    monkeypatch.setattr(voice_mode, "_win_player_proc", lambda: player)
+    monkeypatch.setattr(subprocess, "check_output", lambda *a, **k: "\\\\wsl.localhost\\x\\a.wav\n")
+    return player
+
+
+def test_wav_plays_through_windows_player(monkeypatch, wav):
+    player = _wsl(monkeypatch, "ok")
+    monkeypatch.setattr(voice_mode, "_run_system_player", lambda cmd: pytest.fail(f"fell through to {cmd}"))
+
+    assert voice_mode.play_audio_file(wav)
+    assert player.written == ["\\\\wsl.localhost\\x\\a.wav\n"]
+
+
+def test_windows_player_error_falls_back_to_paplay(monkeypatch, wav):
+    _wsl(monkeypatch, "err")
+    ran = []
+    monkeypatch.setattr(voice_mode.shutil, "which", lambda name: "/usr/bin/" + name)
+    monkeypatch.setattr(voice_mode, "_run_system_player", lambda cmd: ran.append(cmd[0]) or True)
+
+    assert voice_mode.play_audio_file(wav)
+    assert ran == ["paplay"]
+
+
+def test_beeps_skip_sounddevice_on_wsl(monkeypatch):
+    monkeypatch.setattr(voice_mode, "is_wsl", lambda: True)
+
+    assert not voice_mode._sounddevice_output_allowed()
