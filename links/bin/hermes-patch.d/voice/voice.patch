+class WindowsMicRecorder(AudioRecorder):
+    """WSL recorder that reads the Windows default microphone through Windows ``ffmpeg.exe``
+    (OpenAL) over a pipe, bypassing WSLg PulseAudio, PortAudio and any bridge. Each
+    recording starts a fresh capture, so it follows the current Windows default mic."""
+
+    _BLOCK = 1600  # 100 ms at 16 kHz
+
+    def __init__(self, ffmpeg: str) -> None:
+        super().__init__()
+        self._ffmpeg = ffmpeg
+        self._proc: Optional[subprocess.Popen] = None
+        self._sample_rate = SAMPLE_RATE
+
+    def start(self, on_silence_stop=None) -> None:
+        with self._lock:
+            if self._recording:
+                return
+            self._frames = []
+            self._start_time = time.monotonic()
+            self._reset_detection_state()
+            self._peak_rms = 0
+            self._current_rms = 0
+            self._on_silence_stop = on_silence_stop
+        self._close_stream_with_timeout()
+        self._ensure_stream()
+        self._open_live_session(self._sample_rate)
+        with self._lock:
+            self._recording = True
+        logger.info("Voice recording started (Windows mic via ffmpeg.exe, rate=%d)", self._sample_rate)
+
+    def _ensure_stream(self) -> None:
+        if self._proc is not None and self._proc.poll() is None:
+            return
+        self._close_stream_with_timeout()
+        import numpy as np
+        # An empty OpenAL device name is the Windows default capture device.
+        proc = subprocess.Popen(
+            [self._ffmpeg, "-hide_banner", "-loglevel", "error", "-f", "openal",
+             "-channels", "1", "-sample_rate", "48000", "-sample_size", "16", "-i", "",
+             "-ac", "1", "-ar", str(self._sample_rate), "-f", "s16le", "-"],
+            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd="/mnt/c")
+        self._proc = proc
+        nbytes = self._BLOCK * SAMPLE_WIDTH
+
+        def _reader():
+            while True:
+                data = proc.stdout.read(nbytes)
+                if not data:
+                    if self._proc is not proc:
+                        return  # closed on purpose
+                    err = (proc.stderr.read() or b"").decode(errors="replace").strip()
+                    logger.warning("Windows mic capture ended: %s", err or f"exit {proc.poll()}")
+                    return
+                if self._recording:
+                    block = np.frombuffer(data[: len(data) // 2 * 2], dtype=np.int16).reshape(-1, 1)
+                    self._on_audio_block(np, block)
+
+        threading.Thread(target=_reader, daemon=True, name="windows-mic").start()
+        logger.info("Windows mic capture started (default device)")
+
+    def _stop_capture(self) -> Optional[str]:
+        import numpy as np  # base class imports via _import_audio (sounddevice); not needed here
+        with self._lock:
+            if not self._recording:
+                return None
+            self._recording, self._current_rms = False, 0
+            frames, self._frames = self._frames, []
+        self._close_stream_with_timeout()
+        if not frames:
+            return None
+        audio_data = np.concatenate(frames, axis=0)
+        logger.info("Voice recording stopped (%.1fs, %d samples)",
+                    time.monotonic() - self._start_time, len(audio_data))
+        if len(audio_data) < int(self._sample_rate * 0.3):
+            return None
+        if self._peak_rms < self._silence_threshold:
+            logger.info("Recording too quiet (peak RMS=%d < %d), discarding",
+                        self._peak_rms, self._silence_threshold)
+            return None
+        return self._write_wav(audio_data, sample_rate=self._sample_rate)
+
+    def _close_stream_with_timeout(self, timeout: float = 3.0) -> None:
+        proc, self._proc = self._proc, None
+        if proc is not None and proc.poll() is None:
+            proc.kill()
+            with suppress(Exception):
+                proc.wait(timeout=timeout)
+
