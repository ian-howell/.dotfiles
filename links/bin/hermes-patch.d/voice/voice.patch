@@ -1009,6 +1012,57 @@ def _wsl_powershell_tts_available() -> bool:
     return bool(is_wsl() and shutil.which("powershell.exe") and shutil.which("ffmpeg"))
 
 
+# WSLg's RDP audio path adds seconds of latency and can die until `wsl --shutdown`.
+# A resident Windows PowerShell plays WAVs natively instead: no per-sound start-up,
+# so beeps sound immediately. One WAV path per stdin line, "ok"/"err" per reply.
+_WIN_PLAYER_SCRIPT = (
+    "$p=New-Object Media.SoundPlayer;"
+    "while(($l=[Console]::In.ReadLine()) -ne $null){"
+    "try{$p.SoundLocation=$l;$p.PlaySync();[Console]::Out.WriteLine('ok')}"
+    "catch{[Console]::Out.WriteLine('err')};[Console]::Out.Flush()}"
+)
+_win_player = None
+_win_player_lock = threading.Lock()
+
+
+def _win_player_proc():
+    global _win_player
+    if _win_player is None or _win_player.poll() is not None:
+        ps = shutil.which("powershell.exe") or "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
+        if not os.path.exists(ps):
+            return None
+        _win_player = subprocess.Popen(
+            [ps, "-NoProfile", "-NoLogo", "-Command", _WIN_PLAYER_SCRIPT],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+            cwd="/mnt/c", text=True, bufsize=1)
+    return _win_player
+
+
+def _play_wav_via_windows(file_path: str) -> bool:
+    """Play a WAV through the resident Windows player; False when unavailable/failed."""
+    try:
+        win_path = subprocess.check_output(["wslpath", "-w", os.path.abspath(file_path)],
+                                           text=True, timeout=3).strip()
+        with _win_player_lock:
+            proc = _win_player_proc()
+            if proc is None:
+                return False
+            _set_active_playback(proc)
+            try:
+                proc.stdin.write(win_path + "\n")
+                proc.stdin.flush()
+                return proc.stdout.readline().strip() == "ok"
+            finally:
+                _set_active_playback(None)
+    except Exception as e:
+        logger.debug("Windows playback failed: %s", e)
+        return False
+
+
+if is_wsl():  # start PowerShell now so the first beep doesn't wait ~1s for it
+    threading.Thread(target=lambda: suppress(Exception) and _win_player_proc(), daemon=True).start()
+
+
