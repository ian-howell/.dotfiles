     _attach_worker(sid, session, new_worker)
 
 
+_LIST_PRICE_PROVIDERS = (("claude", "anthropic"), ("gpt", "openai"), ("o", "openai"), ("gemini", "google"))
+
+
+_COST_TOKEN_FIELDS = ("input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens")
+
+
+def _session_cost_baseline(agent) -> dict:
+    """Tokens/cost already stored for a resumed session before this agent started counting.
+    Captured once, while the agent's own counters are still zero."""
+    if (base := getattr(agent, "_tui_cost_baseline", None)) is not None:
+        return base
+    if any(getattr(agent, f"session_{f}", 0) for f in _COST_TOKEN_FIELDS):
+        return {}
+    db = getattr(agent, "_session_db", None) or _get_db()
+    row = (db.get_session(getattr(agent, "session_id", None) or "") if db else None) or {}
+    base = {k: row.get(k) or 0 for k in (*_COST_TOKEN_FIELDS, "estimated_cost_usd")}
+    agent._tui_cost_baseline = base
+    return base
+
+
+def _session_cost(agent, usage: dict) -> None:
+    """Set cost_usd/cost_status, including spend from before a resume. Subscription routes
+    (e.g. Copilot) with no per-token pricing are priced at the model vendor's API list rate."""
+    base = _session_cost_baseline(agent)
+    status = getattr(agent, "session_cost_status", "unknown")
+    if status in ("actual", "estimated"):
+        own = float(getattr(agent, "session_estimated_cost_usd", 0) or 0)
+        usage["cost_usd"] = own + float(base.get("estimated_cost_usd") or 0)
+        usage["cost_status"] = status
+        return
+    from agent.usage_pricing import CanonicalUsage, estimate_usage_cost
+    model = (getattr(agent, "model", "") or "").split("/")[-1]
+    vendor = next((p for prefix, p in _LIST_PRICE_PROVIDERS if model.lower().startswith(prefix)), None)
+    if not vendor:
+        return
+    tokens = CanonicalUsage(**{
+        f: int(getattr(agent, f"session_{f}", 0) or 0) + int(base.get(f) or 0) for f in _COST_TOKEN_FIELDS
+    })
+    result = estimate_usage_cost(model, tokens, provider=vendor)
+    if result.amount_usd is not None:
+        usage["cost_usd"] = float(result.amount_usd)
+        usage["cost_status"] = "estimated"
+
+
