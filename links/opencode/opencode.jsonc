{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": true,
  "default_agent": "ask",
  "model": "github-copilot/gpt-5.6-sol-fast",
  "plugin": [],
  "permission": {
    "bash": {
      "ssh": "ask",
      "az": "ask"
    },
    "external_directory": {
      "/tmp/**": "allow"
    }
  }
}
