{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": true,
  "default_agent": "ask",
  "model": "github-copilot/claude-opus-5.5",
  "plugin": [],
  "permission": {
    "bash": {
      "ssh": "ask",
      "az": "ask"
    },
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "shell": "/usr/bin/bash"
}
