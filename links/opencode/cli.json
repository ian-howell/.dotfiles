{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "dotfiles",
    "mode": "system"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "editor": true,
    "paste": "full"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "keybinds": {
    "prompt.editor": "ctrl+g",
    "session.first": "home,alt+home",
    "session.new": "<leader>ctrl+n",
    "session.list": "<leader>ctrl+s",
    "command.palette.show": "<leader>ctrl+p",
    "messages.copy": "<leader>ctrl+y",
    "session.message.next": "ctrl+n",
    "session.message.previous": "ctrl+p",
  }
}
